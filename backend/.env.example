APP_NAME=AI·StyleLink API
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://stylelink:stylelink@localhost:5433/stylelink
JWT_SECRET=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-gmail@gmail.com
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=
FASHION_CLIP_URL=http://127.0.0.1:8001
SIZE_SHIFT_URL=http://127.0.0.1:8001
FIT_MODEL_BACKEND=b2
SURVEY_FRONTEND_URL=http://localhost:5173/survey

# Paid WB pilot. Leave legacy defaults until API keys are configured.
CATALOG_PROVIDER=yandex_market
REVIEWS_PROVIDER=yandex_market
BHAPI_WB_TOKEN=
MPDOWN_API_KEY=
# Set to a numeric WB pickup-point ID for region-specific stock and prices.
# WB_PICKUP_POINT_ID=
MARKETPLACE_SEARCH_LIMIT=20
MARKETPLACE_MAX_CALLS=150
MARKETPLACE_MAX_SEARCHES=6
MARKETPLACE_TIMEOUT_SECONDS=120
MARKETPLACE_REVIEW_LIMIT=20
MARKETPLACE_REVIEW_MAX_PAGES=2
OUTFIT_COUNT=5

# Reviews via Apify (enable REVIEWS_PROVIDER=apify after testing).
APIFY_API_TOKEN=
APIFY_RUN_CAP_USD=0.15
APIFY_GENERATION_CAP_USD=1.0
APIFY_REVIEWS_TIMEOUT_SECONDS=90
# Keep false: Ozon may combine reviews of different size/color SKUs.
APIFY_ALLOW_GROUP_REVIEWS=false
