{
  "schema_version": "review_annotation_v3",
  "unit": "review",
  "primary_key": "review_id",
  "targets": {
    "fit_label": {
      "values": ["runs_small", "true_to_size", "runs_large", "no_signal"],
      "manual_labels_ru": {
        "маломерит": "runs_small",
        "соответствует": "true_to_size",
        "большемерит": "runs_large",
        "нет сигнала": "no_signal"
      }
    },
    "fit_code": {
      "mapping": {
        "runs_small": -1,
        "true_to_size": 0,
        "runs_large": 1,
        "no_signal": null
      }
    },
    "signal_explicitness": {
      "values": ["explicit", "implicit", "none"],
      "manual_labels_ru": {
        "явный": "explicit",
        "неявный": "implicit",
        "нет сигнала": "none"
      }
    },
    "body_parameters": {
      "values": ["height", "bust", "waist", "hips", "other"],
      "manual_labels_ru": {
        "рост": "height",
        "грудь": "bust",
        "талия": "waist",
        "бёдра": "hips",
        "бедра": "hips",
        "другое": "other",
        "нет": null
      },
      "max_items": 3
    },
    "fit_zones": {
      "values": ["bust", "waist", "hips", "shoulders", "sleeves", "length", "other"],
      "manual_labels_ru": {
        "грудь": "bust",
        "талия": "waist",
        "бёдра": "hips",
        "бедра": "hips",
        "плечи": "shoulders",
        "рукава": "sleeves",
        "длина": "length",
        "другое": "other",
        "не указана": null
      },
      "max_items": 3
    },
    "user_action": {
      "values": [
        "not_specified",
        "kept_ordered_size",
        "chose_another_size",
        "exchanged",
        "returned",
        "ordered_multiple_sizes",
        "other"
      ],
      "manual_labels_ru": {
        "не указано": "not_specified",
        "оставил заказанный размер": "kept_ordered_size",
        "взял другой размер": "chose_another_size",
        "обменял": "exchanged",
        "вернул": "returned",
        "заказал несколько размеров": "ordered_multiple_sizes",
        "другое": "other"
      }
    },
    "internal_consistency": {
      "values": ["consistent", "contradictory", "unclear"],
      "manual_labels_ru": {
        "согласованный": "consistent",
        "противоречивый": "contradictory",
        "неясно": "unclear"
      }
    },
    "informativeness": {
      "values": ["low", "medium", "high"],
      "manual_labels_ru": {
        "низкая": "low",
        "средняя": "medium",
        "высокая": "high"
      }
    }
  },
  "research_role": {
    "primary_comparison": "equal-weight versus informativeness-weighted aggregation",
    "separate_ablation": "consistency-aware aggregation",
    "item_key": "item_group_id",
    "abstention": "same decision rule for the primary baseline and proposed method"
  }
}
